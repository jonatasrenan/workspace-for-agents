# Configuração de `tools/share.mjs` (publicar um repo como página estática).
# Copie para `.env` (não versionado) e preencha com a SUA infraestrutura:
#   cp .env.example .env
# Sem AWS configurada, `node tools/share.mjs <repo> --dry-run` gera só o HTML local.

# Bucket S3 que serve o site estático
WFA_SHARE_BUCKET=meu-bucket-de-site

# Distribuição CloudFront à frente do bucket (usada para invalidar o cache)
WFA_SHARE_DIST=E123ABC456DEFG

# URL base pública, sem barra final — as páginas ficam em <base>/<uuid>/index.html
WFA_SHARE_BASE=https://exemplo.com

# Credenciais: perfil do AWS CLI com acesso ao bucket e à distribuição
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
