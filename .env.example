# Configuration for `tools/share.mjs` (publish a repo as a static page).
# Copy to `.env` (not versioned) and fill in with YOUR infrastructure:
#   cp .env.example .env
# Without AWS configured, `node tools/share.mjs <repo> --dry-run` only generates the local HTML.

# S3 bucket serving the static site
WFA_SHARE_BUCKET=my-site-bucket

# CloudFront distribution in front of the bucket (used to invalidate the cache)
WFA_SHARE_DIST=E123ABC456DEFG

# Public base URL, no trailing slash — pages live at <base>/<uuid>/index.html
WFA_SHARE_BASE=https://example.com

# Credentials: AWS CLI profile with access to the bucket and the distribution
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
